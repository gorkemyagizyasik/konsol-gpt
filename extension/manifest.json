{
  "manifest_version": 3,
  "name": "Konsol-GPT Cookie & Network Analyzer",
  "version": "1.1.0",
  "description": "ChatGPT oturum çerezlerini ve ağ isteklerini (Network Traces) Konsol-GPT servisine senkronize ve analiz eder.",
  "permissions": [
    "cookies",
    "storage"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "http://localhost:8023/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["analyzer_main.js"],
      "world": "MAIN",
      "run_at": "document_start"
    }
  ]
}
